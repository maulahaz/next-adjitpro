# ============================================================
# Contoh konfigurasi. Salin menjadi `.env.local` (development)
# dan isi nilai sebenarnya. JANGAN commit file `.env.local`.
#
#   Copy-Item .env.example .env.local     (Windows PowerShell)
#   cp .env.example .env.local            (macOS/Linux)
# ============================================================

# ---------- WAJIB ----------

# Development: PostgreSQL lokal (default PostgreSQL di mesin Anda).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/adjitpro_db"

# Production: Neon DB — pakai connection string "pooled" dari dashboard Neon.
# DATABASE_URL="postgres://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/adjitpro_db?sslmode=require"

# ---------- OPSIONAL (ada default) ----------

# Nama aplikasi yang tampil di judul halaman & footer.
# APP_NAME="AdjitPro — Aplikasi Pencatatan Investasi"

# Lama sesi login dalam detik. Default 21600 (6 jam), sama seperti aplikasi lama.
# SESSION_TTL_SECONDS=21600

# Kunci sementara akun setelah sekian kali gagal login.
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_SECONDS=300

# Putaran bcrypt untuk hash password baru (10 = standar, makin besar makin lambat/aman).
# BCRYPT_ROUNDS=10

# Mode notifikasi email. Default "log": email TIDAK dikirim, hanya dicatat ke log
# server (mode "smtp"/"resend" belum diimplementasikan).
# EMAIL_MODE=log

# ---------- NEON OBJECT STORAGE (LAMPIRAN FUNDING) ----------
# Lampiran Funding (PDF/DOC/DOCX, maks 2 MB) disimpan di bucket privat Neon
# Object Storage (kompatibel S3). Kredensial S3 dibuat SEKALI lewat:
#
#   neon credentials create --scope storage:read --scope storage:write --name adjitpro-uploads
#   neon buckets create adjitpro-lampiran
#
# PENTING: Neon API Key (NEON_API_KEY) BUKAN kredensial S3. Nilai di bawah
# berasal dari output `neon credentials create`:
#   token_id              -> AWS_ACCESS_KEY_ID
#   s3_secret_access_key  -> AWS_SECRET_ACCESS_KEY
# Endpoint & region mengikuti branch Neon (lihat `neon env pull` / dashboard).
# AWS_ACCESS_KEY_ID="nak_live_..."
# AWS_SECRET_ACCESS_KEY="nsk_live_..."
# AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech"
# AWS_REGION="us-east-2"
# S3_BUCKET="adjitpro-lampiran"
